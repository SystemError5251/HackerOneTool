# ---------------------------------------------------------------------------
# Basic colours (for the line menu / subcommand output)
# ---------------------------------------------------------------------------
setup_colors() {
  if [[ -n "${NO_COLOR:-}" || ! -t 1 ]]; then
    C_RESET=; C_DIM=; C_BOLD=; C_CYAN=; C_GREEN=; C_YELLOW=; C_RED=; C_MAGENTA=; C_BLUE=
    return
  fi
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_CYAN=$'\033[36m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
  C_RED=$'\033[31m'; C_MAGENTA=$'\033[35m'; C_BLUE=$'\033[34m'
}

info()  { printf '%s»%s %s\n' "$C_CYAN"   "$C_RESET" "$*"; }
ok()    { printf '%s✓%s %s\n' "$C_GREEN"  "$C_RESET" "$*"; }
warn()  { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()   { printf '%s✗%s %s\n' "$C_RED"    "$C_RESET" "$*" >&2; }
pause() { printf '\n%s' "$C_DIM"; read -r -p "$(t press_enter)" _ || true; printf '%s' "$C_RESET"; }

# ---------------------------------------------------------------------------
# License status (read-only, offline — reuses h1common)
# ---------------------------------------------------------------------------
license_status_raw() {
  python3 - "$here" <<'PY' 2>/dev/null || printf 'unknown\n'
import sys
sys.path.insert(0, sys.argv[1])
try:
    import h1common as h
except Exception:
    print("unknown"); raise SystemExit(0)
k = h.load_license_key()
if k is None:
    print("missing")
elif h.license_key_valid(k):
    print("ok\t" + (h.license_subject(k) or ""))
else:
    print("invalid")
PY
}

license_state() { license_status_raw | cut -f1; }
license_subject_of() { local r; r="$(license_status_raw)"; [[ "$r" == ok* ]] && printf '%s' "${r#ok$'\t'}"; }

license_status_label() {
  case "$(license_state)" in
    ok)      printf '%s%s%s' "$C_GREEN"  "$(t lic_ok)"      "$C_RESET" ;;
    missing) printf '%s%s%s' "$C_YELLOW" "$(t lic_missing)" "$C_RESET" ;;
    invalid) printf '%s%s%s' "$C_RED"    "$(t lic_invalid)" "$C_RESET" ;;
    *)       printf '%s%s%s' "$C_DIM"    "$(t lic_unknown)" "$C_RESET" ;;
  esac
}

# ---------------------------------------------------------------------------
# Offline mode
# ---------------------------------------------------------------------------
BBP_OFFLINE="${BBP_OFFLINE:-off}"

mode_label() {
  case "$BBP_OFFLINE" in
    auto)  printf '%s%s%s' "$C_GREEN"  "$(t mode_auto)"   "$C_RESET" ;;
    mock)  printf '%s%s%s' "$C_YELLOW" "$(t mode_mock)"   "$C_RESET" ;;
    local) printf '%s%s%s' "$C_GREEN"  "$(t mode_local)"  "$C_RESET" ;;
    *)     printf '%s%s%s' "$C_BLUE"   "$(t mode_online)" "$C_RESET" ;;
  esac
}

# Is something listening on a loopback TCP port? Pure python3, no extra tools.
port_open() {
  python3 - "$1" <<'PY' 2>/dev/null
import socket, sys
s = socket.socket(); s.settimeout(1.0)
try:
    s.connect(("127.0.0.1", int(sys.argv[1]))); print("open")
except Exception:
    pass
finally:
    s.close()
PY
}

# Collapse "auto" to a concrete backend: local if a server is up on :8080,
# otherwise the bundled mock. off/mock/local pass through.
effective_offline() {
  if [[ "$BBP_OFFLINE" == "auto" ]]; then
    [[ "$(port_open 8080)" == "open" ]] && printf 'local' || printf 'mock'
  else
    printf '%s' "$BBP_OFFLINE"
  fi
}

# A model safe to use out in offline mode (loopback providers only).
offline_model_ok() { case "$1" in mock/*|llamacpp/*) return 0;; *) return 1;; esac; }

# The model bbp would hand analyze.sh for the current settings (for the doctor).
resolve_model() {
  if [[ "$BBP_OFFLINE" == "off" ]]; then
    printf '%s' "${MODEL:-}"
  elif [[ -n "${MODEL:-}" ]] && offline_model_ok "$MODEL"; then
    printf '%s' "$MODEL"
  else
    printf ''   # unset: analyze.sh auto-detects the loopback provider
  fi
}

# ---------------------------------------------------------------------------
# Actions (shared by the UI and the subcommands)
# ---------------------------------------------------------------------------
run_scope()   { python3 "$here/h1scope.py"   "$@"; }
run_reports() { python3 "$here/h1reports.py" "$@"; }
run_report()  { python3 "$here/h1report.py"  "$@"; }

need_opencode() {
  command -v opencode >/dev/null 2>&1 && return 0
  err "$(t need_opencode)"; return 1
}

# analyze <scope|reports|report> <arg>
run_analyze() {
  local kind="$1" arg="$2" backend mock_pid="" rc=0
  need_opencode || return 1
  backend="$(effective_offline)"

  if [[ "$backend" != "off" ]]; then
    # Offline: refuse an external MODEL override outright, then make sure the
    # chosen loopback backend is up. analyze.sh (>= the offline-integration
    # change) auto-detects the loopback provider, so we leave MODEL unset.
    if [[ -n "${MODEL:-}" ]] && ! offline_model_ok "$MODEL"; then
      err "$(t guard_block): $MODEL"; warn "$(t guard_hint)"; return 1
    fi
    if [[ "$backend" == "local" ]]; then
      [[ "$(port_open 8080)" == "open" ]] || { err "$(t local_unreach)"; return 1; }
    elif [[ "$backend" == "mock" ]]; then
      if [[ "$(port_open "$MOCK_PORT")" != "open" ]]; then
        info "$(t mock_boot)"
        python3 "$here/mock_model_server.py" --port "$MOCK_PORT" >/dev/null 2>&1 &
        mock_pid=$!
        local i
        for i in $(seq 1 20); do
          [[ "$(port_open "$MOCK_PORT")" == "open" ]] && break
          kill -0 "$mock_pid" 2>/dev/null || { err "$(t mock_dead)"; return 1; }
          sleep 0.3
        done
      fi
    fi
    info "$(t analyzing)"
    if [[ -n "${MODEL:-}" ]] && offline_model_ok "$MODEL"; then
      MODEL="$MODEL" "$here/analyze.sh" "$kind" "$arg" || rc=$?
    else
      ( unset MODEL; "$here/analyze.sh" "$kind" "$arg" ) || rc=$?
    fi
    if [[ -n "$mock_pid" ]]; then kill "$mock_pid" 2>/dev/null || true; wait "$mock_pid" 2>/dev/null || true; fi
    return "$rc"
  fi

  # Online: pass MODEL through as-is (analyze.sh still runs OpenCode offline,
  # but honours an explicit provider/model).
  info "$(t analyzing)"
  if [[ -n "${MODEL:-}" ]]; then
    MODEL="$MODEL" "$here/analyze.sh" "$kind" "$arg"
  else
    "$here/analyze.sh" "$kind" "$arg"
  fi
}

# ---------------------------------------------------------------------------
# Line-menu screens (used by --no-tui and after leaving the full-screen UI)
# ---------------------------------------------------------------------------
screen_scope() {
  local h; read -r -p "$(t prompt_handle): " h || h=""
  [[ -z "$h" ]] && { warn "$(t empty_input)"; return; }
  printf '\n'; run_scope "$h" --policy || true; pause
}
screen_reports() {
  local h; read -r -p "$(t prompt_handle): " h || h=""
  [[ -z "$h" ]] && { warn "$(t empty_input)"; return; }
  printf '\n'; run_reports "$h" --limit 50 || true; pause
}
screen_report() {
  local id; read -r -p "$(t prompt_report): " id || id=""
  [[ -z "$id" ]] && { warn "$(t empty_input)"; return; }
  printf '\n'; run_report "$id" || true; pause
}
screen_analyze() {
  local k kind h
  printf '%s\n' "$(t prompt_kind)"
  read -r -p "$(t ti_scope) [1/2/3]: " k || k=""
  case "$k" in 1) kind=scope;; 2) kind=reports;; 3) kind=report;; *) warn "$(t invalid_choice)"; return;; esac
  if [[ "$kind" == "report" ]]; then read -r -p "$(t prompt_report): " h || h=""
  else read -r -p "$(t prompt_handle): " h || h=""; fi
  [[ -z "$h" ]] && { warn "$(t empty_input)"; return; }
  printf '\n'; run_analyze "$kind" "$h" || true; pause
}
screen_offline() {
  printf '\n  %s%s%s\n' "$C_BOLD" "$(t offline_title)" "$C_RESET"
  printf '    1) %s\n    2) %s\n    3) %s\n    4) %s\n\n' \
    "$(t off_online)" "$(t off_auto)" "$(t off_mock)" "$(t off_local)"
  local c; read -r -p "  [1/2/3/4]: " c || c=""
  case "$c" in 1) BBP_OFFLINE=off;; 2) BBP_OFFLINE=auto;; 3) BBP_OFFLINE=mock;; 4) BBP_OFFLINE=local;; *) warn "$(t invalid_choice)"; return;; esac
  ok "$(t mode_set): $(mode_label)"
}
screen_license() {
  printf '\n  %s%s%s\n' "$C_BOLD" "$(t lic_title)" "$C_RESET"
  printf '    %s: %s\n' "$(t status_lic)" "$(license_status_label)"
  local subj; subj="$(license_subject_of)"
  [[ -n "$subj" ]] && printf '    %s: %s\n' "$(t lic_subject)" "$subj"
  printf '\n'
  local key; read -r -p "  $(t lic_install_q): " key || key=""
  if [[ -n "$key" ]]; then
    if python3 "$here/h1license.py" install "$key" >/dev/null 2>&1; then ok "$(t lic_installed)"; else err "$(t lic_badkey)"; fi
  fi
  pause
}

# ---------------------------------------------------------------------------
# Environment doctor — read-only, loopback probes only, no external egress.
# ---------------------------------------------------------------------------
cmd_check() {
  local model guard oc mock_s local_s
  model="$(resolve_model)"
  if [[ "$BBP_OFFLINE" == "off" ]]; then guard="$(t guard_na)"
  elif [[ -n "${MODEL:-}" ]] && ! offline_model_ok "$MODEL"; then guard="$(t guard_block)"
  else guard="$(t guard_ok)"; fi
  command -v opencode >/dev/null 2>&1 && oc="$(t present)" || oc="$(t missing)"
  [[ "$(port_open "$MOCK_PORT")" == "open" ]] && mock_s="$(t reachable)" || mock_s="$(t unreachable)"
  [[ "$(port_open 8080)" == "open" ]] && local_s="$(t reachable)" || local_s="$(t unreachable)"

  printf '\n  %s%s%s\n' "$C_BOLD" "$(t check_title)" "$C_RESET"
  printf '    %-26s %s\n' "$(t c_lang):"     "$BBP_LANG"
  printf '    %-26s %s\n' "$(t c_mode):"     "$(mode_label)"
  printf '    %-26s %s\n' "$(t c_model):"    "${model:-$(t auto_default)}"
  printf '    %-26s %s\n' "$(t c_guard):"    "$guard"
  printf '    %-26s %s\n' "$(t status_lic):" "$(license_status_label)"
  printf '    %-26s %s\n' "$(t c_opencode):" "$oc"
  printf '    %-26s %s\n' "$(t c_mock):"     "$mock_s"
  printf '    %-26s %s\n' "$(t c_local):"    "$local_s"
  printf '\n'
}

