#!/usr/bin/env bash
# bbp — one command for all of HackerOneTool, bilingual (DE/EN).
#
# A single, polished entry point that bundles the recon helpers (h1scope,
# h1reports, h1report) and the OpenCode AI analysis (analyze.sh) behind one
# full-screen terminal UI. You pick the language right when you start it —
# interactively with arrow keys, or with `bbp --lang de|en` — and it's
# remembered.
#
# On a real terminal `bbp` opens a full-screen, keyboard-driven UI (a teal
# title bar with the language code, an inline language switcher and a
# searchable language list, a categorised menu with a description per entry,
# and a keybind bar). Piped or with `--no-tui` it falls back to a plain line
# menu, and every feature is also a direct subcommand, so it stays scriptable.
#
# Everything bbp does flows through the existing gated helpers, so the Ed25519
# license gate in h1common still fires exactly as before — bbp never bypasses
# it. The recon helpers are read-only against HackerOne's public API.
#
# Offline mode runs the AI analysis against a loopback-only model (a local
# llama.cpp server, or the bundled mock) and refuses any external provider, so
# nothing leaves your machine while you are testing in scope.
#
# Usage:
#   bbp                         # interactive UI (asks for a language first)
#   bbp --lang de               # force German, then the UI
#   bbp --no-tui                # plain line menu instead of the full-screen UI
#   bbp scope    <handle>       # program scope + policy
#   bbp reports  <handle>       # disclosed reports
#   bbp report   <id|url>       # one disclosed report
#   bbp analyze  <scope|reports|report> <arg>   # AI analysis of the above
#   bbp --offline analyze scope <handle>        # analysis, loopback model only
#   bbp license                 # license-key status / install
#   bbp check                   # environment doctor (read-only, no egress)
#   bbp help | --help           # this help
#   bbp version | --version     # version
#
# Environment:
#   BBP_LANG=de|en              # default language (overrides the saved config)
#   BBP_OFFLINE=off|auto|mock|local  # default offline backend for `analyze`
#   MODEL=provider/model        # model for analysis (as for analyze.sh)
#   NO_COLOR=1                  # disable colour
#   BBP_NO_TUI=1                # never use the full-screen UI
set -euo pipefail

VERSION="1.1.0"
here="$(cd "$(dirname "$0")" && pwd)"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bbp"
CONFIG_FILE="$CONFIG_DIR/config"

# Offline backends and the loopback endpoints they are pinned to.
MOCK_PORT="8787"

# Languages bbp ships translations for. Data-driven so more can be added: give
# the catalogue a column in t()/tr-style and add a row here (code native english).
LANG_CODES=(de en)
lang_native() { case "$1" in de) printf 'Deutsch';; en) printf 'English';; *) printf '%s' "$1";; esac; }
lang_english() { case "$1" in de) printf 'German';;  en) printf 'English';; *) printf '%s' "$1";; esac; }

# ---------------------------------------------------------------------------
# Language / config
# ---------------------------------------------------------------------------
BBP_LANG="${BBP_LANG:-}"

load_config() {
  if [[ -z "$BBP_LANG" && -r "$CONFIG_FILE" ]]; then
    local v
    v="$(sed -n 's/^lang=//p' "$CONFIG_FILE" 2>/dev/null | head -1)"
    [[ "$v" == "de" || "$v" == "en" ]] && BBP_LANG="$v"
  fi
}

save_lang() {
  mkdir -p "$CONFIG_DIR" 2>/dev/null || return 0
  printf 'lang=%s\n' "$1" >"$CONFIG_FILE" 2>/dev/null || true
}

