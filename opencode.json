{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "METHODOLOGY.md"],
  "model": "llamacpp/local",
  "small_model": "llamacpp/local",
  "enabled_providers": ["llamacpp", "mock"],
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local, offline)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "{env:OCL_LLAMA_API_KEY}"
      },
      "models": {
        "local": {
          "name": "Local GGUF model (llama-server)",
          "tool_call": true,
          "limit": { "context": 16384, "output": 2048 }
        }
      }
    },
    "mock": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Mock (offline test, no model needed)",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "mock"
      },
      "models": {
        "mock-1": { "name": "Mock 1 (deterministic)" }
      }
    }
  },
  "autoupdate": false,
  "share": "disabled",
  "lsp": false,
  "formatter": false,
  "experimental": {
    "openTelemetry": false
  },
  "permission": {
    "edit": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "bash": {
      "python3 *": "allow",
      "./analyze.sh *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "git remote*": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "pip install*": "deny",
      "npm install*": "deny",
      "npx *": "deny",
      "bunx *": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -r *": "deny",
      "*curl *": "deny",
      "*wget *": "deny",
      "*/dev/tcp/*": "deny",
      "*": "ask"
    }
  }
}
