tui_available() {
  [[ -t 0 && -t 1 ]] || return 1
  [[ -z "${BBP_NO_TUI:-}" ]] || return 1
  [[ -z "${NO_COLOR:-}" ]] || return 1
  case "${TERM:-dumb}" in dumb|"") return 1;; esac
  command -v tput >/dev/null 2>&1 || return 1
  return 0
}

setup_tui_theme() {
  local n; n="$(tput colors 2>/dev/null || echo 8)"
  RESET=$'\033[0m'
  if [[ "$n" -ge 256 ]]; then
    BAR=$'\033[48;5;23m\033[38;5;159m'; BARB=$'\033[1;48;5;23m\033[38;5;195m'
    ACC=$'\033[38;5;44m'; DIMC=$'\033[38;5;245m'; CATC=$'\033[1;38;5;108m'
    NUMC=$'\033[38;5;80m'; SELBG=$'\033[48;5;24m'; SELTX=$'\033[1;38;5;231m'; SELDI=$'\033[38;5;159m'
  else
    BAR=$'\033[46;30m'; BARB=$'\033[1;46;30m'
    ACC=$'\033[36m'; DIMC=$'\033[2m'; CATC=$'\033[1;36m'
    NUMC=$'\033[36m'; SELBG=$'\033[46m'; SELTX=$'\033[1;30m'; SELDI=$'\033[30m'
  fi
}

tui_enter() {
  [[ "$TUI_ACTIVE" == 1 ]] && return 0
  tput smcup 2>/dev/null || true; tput civis 2>/dev/null || true
  stty -echo 2>/dev/null || true
  TUI_ACTIVE=1
}
tui_leave() {
  [[ "$TUI_ACTIVE" == 1 ]] || return 0
  stty echo 2>/dev/null || true
  tput cnorm 2>/dev/null || true; tput rmcup 2>/dev/null || true
  TUI_ACTIVE=0
}

# term size (re-read each render so a resize is picked up)
COLS=80; ROWS=24
tui_size() { COLS="$(tput cols 2>/dev/null || echo 80)"; ROWS="$(tput lines 2>/dev/null || echo 24)"; }

# truncate a plain string to at most $2 display cells (char count ~ cells here)
trunc() { local s="$1" m="$2"; if (( ${#s} > m )); then printf '%s…' "${s:0:m-1}"; else printf '%s' "$s"; fi; }

# a full-width line painted in $2 (background colour), left text $1 (plain)
fill_line() {
  local text="$1" color="$2" len pad
  text="$(trunc "$text" "$COLS")"; len=${#text}; pad=$(( COLS - len )); (( pad < 0 )) && pad=0
  printf '%s%s%*s%s\n' "$color" "$text" "$pad" '' "$RESET"
}

tui_titlebar() {
  local left="$1" right="$2" len pad
  len=$(( ${#left} + ${#right} + 2 )); pad=$(( COLS - len )); (( pad < 0 )) && pad=0
  printf '%s %s%*s%s %s\n' "$BARB" "$left" "$pad" '' "$right" "$RESET"
}
tui_keybar() {
  local s; s="$(trunc " $1" "$COLS")"; local pad=$(( COLS - ${#s} )); (( pad < 0 )) && pad=0
  tput cup $(( ROWS - 1 )) 0 2>/dev/null || true
  printf '%s%s%*s%s' "$BAR" "$s" "$pad" '' "$RESET"
}

# --- read a key into REPLY_KEY (up/down/left/right/enter/esc/bksp/char) ---
REPLY_KEY=""; REPLY_CHAR=""
read_key() {
  local k seq; REPLY_KEY=""; REPLY_CHAR=""
  IFS= read -rsn1 k 2>/dev/null || { REPLY_KEY=quit; return; }
  if [[ "$k" == $'\e' ]]; then
    IFS= read -rsn2 -t 0.03 seq 2>/dev/null || seq=""
    case "$seq" in
      '[A') REPLY_KEY=up ;; '[B') REPLY_KEY=down ;;
      '[C') REPLY_KEY=right ;; '[D') REPLY_KEY=left ;;
      '') REPLY_KEY=esc ;; *) REPLY_KEY=other ;;
    esac
    return
  fi
  case "$k" in
    '') REPLY_KEY=enter ;;
    $'\n'|$'\r') REPLY_KEY=enter ;;
    $'\177'|$'\b') REPLY_KEY=bksp ;;
    *) REPLY_KEY=char; REPLY_CHAR="$k" ;;
  esac
}

# --- menu model ---
MENU_ITEMS=(scope reports report analyze offline license check settings help)
item_title() { t "ti_$1"; }
item_desc()  { t "td_$1"; }

cur_lang_display() { printf '%s (%s)' "$(lang_native "$BBP_LANG")" "$(lang_english "$BBP_LANG")"; }

cycle_lang() {
  local dir="$1" i n cur=0
  n=${#LANG_CODES[@]}
  for i in "${!LANG_CODES[@]}"; do [[ "${LANG_CODES[$i]}" == "$BBP_LANG" ]] && cur=$i; done
  cur=$(( (cur + dir + n) % n ))
  BBP_LANG="${LANG_CODES[$cur]}"; save_lang "$BBP_LANG"
}

SEL=0
render_menu() {
  tui_size; tput clear 2>/dev/null || true
  tui_titlebar "◆ $(t app_title)" "$(printf '%s' "$BBP_LANG" | tr '[:lower:]' '[:upper:]')"
  printf '\n'
  printf '  %s%s%s   %s◄ %s ►%s\n' "$CATC" "$(t lang_row)" "$RESET" "$ACC" "$(cur_lang_display)" "$RESET"
  printf '  %s%s%s\n\n' "$DIMC" "$(t lang_hint)" "$RESET"

  local i id n title desc
  for i in "${!MENU_ITEMS[@]}"; do
    case "$i" in
      0) printf '  %s%s%s\n' "$CATC" "$(t cat_recon)"   "$RESET" ;;
      3) printf '  %s%s%s\n' "$CATC" "$(t cat_analyse)" "$RESET" ;;
      4) printf '  %s%s%s\n' "$CATC" "$(t cat_system)"  "$RESET" ;;
    esac
    id="${MENU_ITEMS[$i]}"; n=$(( i + 1 ))
    title="$(item_title "$id")"; desc="$(trunc "$(item_desc "$id")" $(( COLS - 7 )))"
    if [[ "$i" == "$SEL" ]]; then
      fill_line "  $n  $title" "$SELBG$SELTX"
      fill_line "     $desc"   "$SELBG$SELDI"
    else
      printf '  %s%s%s  %s%s%s\n' "$NUMC" "$n" "$RESET" "$ACC" "$title" "$RESET"
      printf '     %s%s%s\n' "$DIMC" "$desc" "$RESET"
    fi
  done
  tui_keybar "$(t kb_main)"
}

# run a line-based screen outside the alt-screen, then come back
tui_suspend() { tui_leave; "$@"; tui_enter; }

activate_item() {
  local id="${MENU_ITEMS[$1]}"
  case "$id" in
    scope)    tui_suspend screen_scope ;;
    reports)  tui_suspend screen_reports ;;
    report)   tui_suspend screen_report ;;
    analyze)  tui_suspend screen_analyze ;;
    offline)  offline_tui ;;
    license)  tui_suspend screen_license ;;
    check)    tui_leave; cmd_check; pause; tui_enter ;;
    settings) settings_tui ;;
    help)     tui_leave; show_help; pause; tui_enter ;;
  esac
}

# generic single-choice list screen (title, options array by name) → REPLY_IDX
REPLY_IDX=-1
pick_tui() {
  local title="$1"; shift
  local opts=("$@") sel=0 n=${#opts[@]} i
  while true; do
    tui_size; tput clear 2>/dev/null || true
    tui_titlebar "◆ $(t app_title)  ›  $title" "$(printf '%s' "$BBP_LANG" | tr '[:lower:]' '[:upper:]')"
    printf '\n'
    for i in "${!opts[@]}"; do
      if [[ "$i" == "$sel" ]]; then fill_line "  ❯ ${opts[$i]}" "$SELBG$SELTX"
      else printf '    %s%s%s\n' "$ACC" "${opts[$i]}" "$RESET"; fi
    done
    tui_keybar "$(t kb_sub)"
    read_key
    case "$REPLY_KEY" in
      up) sel=$(( (sel - 1 + n) % n ));;
      down) sel=$(( (sel + 1) % n ));;
      enter) REPLY_IDX=$sel; return 0 ;;
      esc|quit) REPLY_IDX=-1; return 1 ;;
      char) case "$REPLY_CHAR" in q|Q) REPLY_IDX=-1; return 1;; esac ;;
    esac
  done
}

offline_tui() {
  pick_tui "$(t offline_title)" \
    "$(t off_online)" "$(t off_auto)" "$(t off_mock)" "$(t off_local)" || return 0
  case "$REPLY_IDX" in 0) BBP_OFFLINE=off;; 1) BBP_OFFLINE=auto;; 2) BBP_OFFLINE=mock;; 3) BBP_OFFLINE=local;; esac
}

settings_tui() {
  while true; do
    pick_tui "$(t settings_title)" \
      "$(t set_lang)      ‹ $(cur_lang_display) ›" \
      "$(t set_offline)   ‹ $(mode_plain) ›" \
      "$(t set_help)" \
      "$(t set_back)" || return 0
    case "$REPLY_IDX" in
      0) lang_list_tui ;;
      1) offline_tui ;;
      2) tui_leave; show_help; pause; tui_enter ;;
      3|*) return 0 ;;
    esac
  done
}
# plain (uncoloured) mode label for embedding in menu rows
mode_plain() { case "$BBP_OFFLINE" in auto) t mode_auto;; mock) t mode_mock;; local) t mode_local;; *) t mode_online;; esac; }

# searchable language list (AIO "choose your language")
lang_list_tui() {
  local query="" sel=0
  while true; do
    # filtered codes
    local filtered=() code nat eng hay
    for code in "${LANG_CODES[@]}"; do
      nat="$(lang_native "$code")"; eng="$(lang_english "$code")"
      hay="$(printf '%s %s %s' "$code" "$nat" "$eng" | tr '[:upper:]' '[:lower:]')"
      if [[ -z "$query" || "$hay" == *"$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')"* ]]; then
        filtered+=("$code")
      fi
    done
    local n=${#filtered[@]}
    (( n == 0 )) && sel=0
    (( sel >= n && n > 0 )) && sel=$(( n - 1 ))

    tui_size; tput clear 2>/dev/null || true
    tui_titlebar "◆ $(t app_title)  ›  $(t lang_pick)" "$(printf '%s' "$BBP_LANG" | tr '[:lower:]' '[:upper:]')"
    printf '\n  %s%s%s %s%s%s\n' "$CATC" "$(t search)" "$RESET" "$ACC" "${query:-·}" "$RESET"
    printf '  %s%s%s\n\n' "$DIMC" "$(t search_hint)" "$RESET"
    local i code2 nat2 eng2 row
    for i in "${!filtered[@]}"; do
      code2="${filtered[$i]}"; nat2="$(lang_native "$code2")"; eng2="$(lang_english "$code2")"
      row="$(printf '  %-22s %-14s %s' "$nat2" "$eng2" "$(printf '%s' "$code2" | tr '[:lower:]' '[:upper:]')")"
      if [[ "$i" == "$sel" ]]; then fill_line "$row" "$SELBG$SELTX"
      else printf '%s%s%s\n' "$ACC" "$row" "$RESET"; fi
    done
    tui_keybar "$(t kb_list)"
    read_key
    case "$REPLY_KEY" in
      up) (( n > 0 )) && sel=$(( (sel - 1 + n) % n )) ;;
      down) (( n > 0 )) && sel=$(( (sel + 1) % n )) ;;
      enter) (( n > 0 )) && { BBP_LANG="${filtered[$sel]}"; save_lang "$BBP_LANG"; return 0; } ;;
      esc|quit) return 0 ;;
      bksp) query="${query%?}" ; sel=0 ;;
      char) query="$query$REPLY_CHAR"; sel=0 ;;
    esac
  done
}

menu_tui() {
  local n=${#MENU_ITEMS[@]}
  SEL=0
  trap 'tui_leave' EXIT
  tui_enter
  # First run: no language chosen yet → open the language list, AIO-style.
  [[ -z "$BBP_LANG" ]] && { BBP_LANG="${LANG_CODES[0]}"; lang_list_tui; }
  while true; do
    render_menu
    read_key
    case "$REPLY_KEY" in
      up)    SEL=$(( (SEL - 1 + n) % n )) ;;
      down)  SEL=$(( (SEL + 1) % n )) ;;
      left)  cycle_lang -1 ;;
      right) cycle_lang +1 ;;
      enter) activate_item "$SEL" ;;
      esc)   break ;;
      quit)  break ;;
      char)
        case "$REPLY_CHAR" in
          l|L) lang_list_tui ;;
          s|S) settings_tui ;;
          o|O) offline_tui ;;
          q|Q) break ;;
          [1-9]) local j=$(( REPLY_CHAR - 1 )); (( j < n )) && { SEL=$j; activate_item "$j"; } ;;
        esac ;;
    esac
  done
  tui_leave
  trap - EXIT
}

# ---------------------------------------------------------------------------
# Simple line menu (fallback: not a TTY, --no-tui, or NO_COLOR)
# ---------------------------------------------------------------------------
ask_language_line() {
  printf '\n  %sbbp%s · HackerOneTool\n\n' "$C_BOLD" "$C_RESET"
  printf '  %s / %s\n' "Sprache wählen" "Choose a language"
  printf '    1) Deutsch\n    2) English\n\n'
  local c; read -r -p "  [1/2]: " c || c=""
  case "$c" in 2) BBP_LANG=en;; *) BBP_LANG=de;; esac
  save_lang "$BBP_LANG"
}

menu_loop() {
  while true; do
    printf '\n  %s%s%s — %s\n' "$C_BOLD" "bbp" "$C_RESET" "$(t tagline)"
    printf '  %s%s:%s %s   %s%s:%s %s\n\n' \
      "$C_DIM" "$(t status_lic)" "$C_RESET" "$(license_status_label)" \
      "$C_DIM" "$(t status_mode)" "$C_RESET" "$(mode_label)"
    local i id n
    for i in "${!MENU_ITEMS[@]}"; do
      id="${MENU_ITEMS[$i]}"; n=$(( i + 1 ))
      printf '    %s%s%s) %s\n' "$C_CYAN" "$n" "$C_RESET" "$(item_title "$id")"
    done
    printf '    %s0%s) %s\n\n' "$C_CYAN" "$C_RESET" "$(tr2 "Beenden" "Quit")"
    local c; read -r -p "  $(tr2 "Auswahl" "Choice"): " c || { printf '\n'; break; }
    case "$c" in
      1) screen_scope;; 2) screen_reports;; 3) screen_report;; 4) screen_analyze;;
      5) screen_offline;; 6) screen_license;; 7) cmd_check; pause;;
      8) ask_language_line; ok "$(t lang_saved): $BBP_LANG";;
      9) show_help; pause;;
      0|q|Q) ok "$(t bye)"; break;;
      *) warn "$(t invalid_choice)";;
    esac
  done
}

run_interactive() {
  if tui_available; then
    setup_tui_theme
    menu_tui
  else
    [[ -z "$BBP_LANG" ]] && ask_language_line
    menu_loop
  fi
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
main() {
  load_config
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lang) BBP_LANG="${2:-}"; shift 2 ;;
      --lang=*) BBP_LANG="${1#*=}"; shift ;;
      --offline) BBP_OFFLINE="auto"; shift ;;
      --offline=*) BBP_OFFLINE="${1#*=}"; shift ;;
      --online) BBP_OFFLINE="off"; shift ;;
      --no-tui|--notui) BBP_NO_TUI=1; shift ;;
      --no-color|--no-colour) NO_COLOR=1; shift ;;
      -h|--help) BBP_LANG="${BBP_LANG:-en}"; setup_colors; show_help; return 0 ;;
      -V|--version) show_version; return 0 ;;
      --) shift; while [[ $# -gt 0 ]]; do args+=("$1"); shift; done ;;
      *) args+=("$1"); shift ;;
    esac
  done
  [[ "$BBP_LANG" != "de" && "$BBP_LANG" != "en" ]] && BBP_LANG=""
  case "$BBP_OFFLINE" in off|auto|mock|local) : ;; *) BBP_OFFLINE="off" ;; esac
  setup_colors

  local sub="${args[0]:-}"
  case "$sub" in
    help)    BBP_LANG="${BBP_LANG:-en}"; show_help ;;
    version) show_version ;;
    check)   BBP_LANG="${BBP_LANG:-en}"; cmd_check ;;
    scope)   BBP_LANG="${BBP_LANG:-en}"; run_scope   "${args[@]:1}" ;;
    reports) BBP_LANG="${BBP_LANG:-en}"; run_reports "${args[@]:1}" ;;
    report)  BBP_LANG="${BBP_LANG:-en}"; run_report  "${args[@]:1}" ;;
    analyze)
      BBP_LANG="${BBP_LANG:-en}"
      local kind="${args[1]:-}" arg="${args[2]:-}"
      if [[ -z "$kind" || -z "$arg" ]]; then
        err "$(tr2 "Aufruf: bbp analyze <scope|reports|report> <arg>" \
                   "Usage: bbp analyze <scope|reports|report> <arg>")"
        return 1
      fi
      run_analyze "$kind" "$arg"
      ;;
    license) BBP_LANG="${BBP_LANG:-en}"; screen_license ;;
    "")      run_interactive ;;
    *)
      BBP_LANG="${BBP_LANG:-en}"
      err "$(tr2 "Unbekannter Befehl" "Unknown command"): $sub"
      show_help; return 1 ;;
  esac
}

main "$@"
