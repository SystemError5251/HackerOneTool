  printf '\n'
}

show_version() { printf 'bbp %s (HackerOneTool)\n' "$VERSION"; }

# ---------------------------------------------------------------------------
# Interactive menu loop
# ---------------------------------------------------------------------------
menu_loop() {
  while true; do
    banner
    printf '\n  %s%s%s\n' "$C_BOLD" "$(t menu_title)" "$C_RESET"
    printf '    %s1%s) %s\n' "$C_CYAN" "$C_RESET" "$(t m_scope)"
    printf '    %s2%s) %s\n' "$C_CYAN" "$C_RESET" "$(t m_reports)"
    printf '    %s3%s) %s\n' "$C_CYAN" "$C_RESET" "$(t m_report)"
    printf '    %s4%s) %s\n' "$C_CYAN" "$C_RESET" "$(t m_analyze)"
    printf '    %s5%s) %s\n' "$C_CYAN" "$C_RESET" "$(t m_offline)"
    printf '    %s6%s) %s\n' "$C_CYAN" "$C_RESET" "$(t m_license)"
    printf '    %s7%s) %s\n' "$C_CYAN" "$C_RESET" "$(t m_lang)"
    printf '    %s8%s) %s\n' "$C_CYAN" "$C_RESET" "$(t m_check)"
    printf '    %s9%s) %s\n' "$C_CYAN" "$C_RESET" "$(t m_help)"
    printf '    %s0%s) %s\n\n' "$C_CYAN" "$C_RESET" "$(t m_quit)"
    local c
    read -r -p "  $(t choose): " c || { printf '\n'; break; }
    case "$c" in
      1) screen_scope ;;
      2) screen_reports ;;
      3) screen_report ;;
      4) screen_analyze ;;
      5) screen_offline ;;
      6) screen_license ;;
      7) ask_language ; ok "$(t lang_saved): $BBP_LANG" ;;
      8) cmd_check ; pause ;;
      9) screen_help ;;
      0|q|Q) ok "$(t bye)"; break ;;
      *) warn "$(t invalid_choice)" ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
main() {
  load_config
  local args=()
  # First pass: global flags anywhere on the line.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lang) BBP_LANG="${2:-}"; shift 2 ;;
      --lang=*) BBP_LANG="${1#*=}"; shift ;;
      --offline) BBP_OFFLINE="auto"; shift ;;
      --offline=*) BBP_OFFLINE="${1#*=}"; shift ;;
      --online) BBP_OFFLINE="off"; shift ;;
      --no-color|--no-colour) NO_COLOR=1; shift ;;
      -h|--help) BBP_LANG="${BBP_LANG:-en}"; setup_colors; show_help; return 0 ;;
      -V|--version) show_version; return 0 ;;
      --) shift; while [[ $# -gt 0 ]]; do args+=("$1"); shift; done ;;
      *) args+=("$1"); shift ;;
    esac
  done
  [[ "$BBP_LANG" != "de" && "$BBP_LANG" != "en" ]] && BBP_LANG=""
  case "$BBP_OFFLINE" in off|auto|mock|local) : ;; *) BBP_OFFLINE="off" ;; esac
  setup_colors

  local sub="${args[0]:-}"
  case "$sub" in
    help)    BBP_LANG="${BBP_LANG:-en}"; show_help ;;
    version) show_version ;;
    check)   BBP_LANG="${BBP_LANG:-en}"; cmd_check ;;
    scope)   BBP_LANG="${BBP_LANG:-en}"; run_scope   "${args[@]:1}" ;;
    reports) BBP_LANG="${BBP_LANG:-en}"; run_reports "${args[@]:1}" ;;
    report)  BBP_LANG="${BBP_LANG:-en}"; run_report  "${args[@]:1}" ;;
    analyze)
      BBP_LANG="${BBP_LANG:-en}"
      local kind="${args[1]:-}" arg="${args[2]:-}"
      if [[ -z "$kind" || -z "$arg" ]]; then
        err "$(tr2 "Aufruf: bbp analyze <scope|reports|report> <arg>" \
                   "Usage: bbp analyze <scope|reports|report> <arg>")"
        return 1
      fi
      run_analyze "$kind" "$arg"
      ;;
    license) BBP_LANG="${BBP_LANG:-en}"; screen_license ;;
    "")
      # No subcommand: interactive. Ask for a language first if none is set.
      [[ -z "$BBP_LANG" ]] && { ask_language; setup_colors; }
      menu_loop
      ;;
    *)
      BBP_LANG="${BBP_LANG:-en}"
      err "$(tr2 "Unbekannter Befehl" "Unknown command"): $sub"
      show_help
      return 1
      ;;
  esac
}

main "$@"
